# Ignore everything except manifests, lockfiles, and Rust target paths needed for cargo-chef and uv warmup
*
!rust-toolchain.toml
!Cargo.toml
!Cargo.lock
!pyproject.toml
!uv.lock
!crates/
!crates/arrow-bigquery/
!crates/arrow-bigquery/Cargo.toml
!crates/arrow-bigquery/benches/
!crates/arrow-bigquery/benches/**
!crates/arrow-bigquery/src/
!crates/arrow-bigquery/src/**
!crates/arrow-bigquery/tests/
!crates/arrow-bigquery/tests/**
!py-arrow-bigquery/
!py-arrow-bigquery/Cargo.toml
!py-arrow-bigquery/pyproject.toml
!py-arrow-bigquery/src/
!py-arrow-bigquery/src/**
!py-polars-bigquery/
!py-polars-bigquery/pyproject.toml
!py-polars-expressions-testing/
!py-polars-expressions-testing/Cargo.toml
!py-polars-expressions-testing/pyproject.toml
!py-polars-expressions-testing/src/
!py-polars-expressions-testing/src/**
